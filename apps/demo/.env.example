# Beam Testnet RPC
BEAM_TESTNET_RPC_URL=https://build.onbeam.com/rpc/testnet

# Private keys (server-side only — never exposed to client)
USER_PRIVATE_KEY=0xYOUR_USER_PRIVATE_KEY
FACILITATOR_PRIVATE_KEY=0xYOUR_FACILITATOR_PRIVATE_KEY

# Public wallet addresses (exposed to frontend for display)
NEXT_PUBLIC_USER_WALLET=0xYOUR_USER_WALLET
NEXT_PUBLIC_MERCHANT_WALLET=0xYOUR_MERCHANT_WALLET
NEXT_PUBLIC_FACILITATOR_WALLET=0xYOUR_FACILITATOR_WALLET

# Token addresses on Beam testnet
NEXT_PUBLIC_USDC_ADDRESS=0xYOUR_USDC_ADDRESS
# WBEAM (Wrapped BEAM) on testnet
NEXT_PUBLIC_BEAM_TOKEN_ADDRESS=0xF65B6f9c94187276C7d91F4F74134751d248bFeA
