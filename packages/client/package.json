{
  "name": "@raygate/client",
  "version": "1.0.0",
  "description": "TypeScript client for x402 payments on Beam — beamFetch() and Permit2 signing",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts"
  },
  "dependencies": {
    "@raygate/core": "workspace:*",
    "viem": "^2.21.0"
  },
  "license": "MIT"
}
