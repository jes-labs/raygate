# Beam RPC
BEAM_RPC_URL=https://build.onbeam.com/rpc
BEAM_TESTNET_RPC_URL=https://build.onbeam.com/rpc/testnet

# Facilitator wallet (gas payer only — never holds user funds)
FACILITATOR_PRIVATE_KEY=0xYOUR_PRIVATE_KEY_HERE

# Token addresses on Beam (verify on BeamScan before mainnet)
USDC_BEAM_ADDRESS=0xYourUsdcBeamAddress
BEAM_TOKEN_ADDRESS=0xF65B6f9c94187276C7d91F4F74134751d248bFeA

# Permit2 (universal address on all EVM chains)
PERMIT2_ADDRESS=0x000000000022D473030F116dDEE9F6B43aC78BA3

# Merchant wallet (receives payments)
MERCHANT_WALLET=0xYourMerchantAddress

# Server
PORT=3000
NODE_ENV=development
GAS_WARNING_THRESHOLD=1000000000000000000
LOG_LEVEL=info
